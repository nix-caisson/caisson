<!-- A way back up to the caisson landing page: mdBook's own header has no
     link to the site the book is published under. Rendered above the menu
     bar; everything else in the theme stays mdBook's own.

     The book is built into site/docs, so the landing page is one level
     above the book root: {{ path_to_root }} reaches the book root, and
     ../ from there reaches site/index.html. -->
<div class="caisson-sitebar">
  <a class="caisson-sitebar-home" href="{{ path_to_root }}../">
    <img src="{{ path_to_root }}../assets/favicon.svg" alt="" width="18" height="18">
    <span>caisson</span>
  </a>
  <span class="caisson-sitebar-here" aria-current="page">Docs</span>
</div>
